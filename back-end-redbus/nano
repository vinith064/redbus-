version: "3.9"
 
services:
  backend:
    build:
      context: ./back-end-redbus
    ports:
      - "5000:5000"
    environment:
      - MONGO_URL=mongodb://mongo:27017/redbus
    depends_on:
      - mongo
 
  frontend:
    build:
      context: ./front-end-redbus
    ports:
      - "3000:80"
    depends_on:
      - backend
 
  mongo:
    image: mongo:latest
    ports:
      - "27017:27017"
    volumes:
      - mongo-data:/data/db
 
volumes:
  mongo-data:
